    }
  ],
  "formulaRenameSample": {
    "propertyName": "Preço",
    "expression": "prop(\"Preço\") + naoExiste",
    "note": "Reservado para a peça de fórmula (fora do escopo de N2). O nome acentuado precede o span de erro de propósito, para provar que o deslocamento UTF-8→UTF-16 não se perde em nome com acento."
  }
