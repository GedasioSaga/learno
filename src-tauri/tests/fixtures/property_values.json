      "expectedSortText": "opt_a",
      "expectedSortNum": null,
      "expectedIsEmpty": false
    },
    {
      "id": "option_list_empty_array_is_no_row",
      "propertyType": "multi_select",
      "config": {
        "options": [
          {
            "id": "opt_a",
            "label": "A Fazer",
            "color": "gray"
          }
        ]
      },
      "value": [],
