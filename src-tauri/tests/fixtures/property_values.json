{
  "$schema": "Casos canônicos de PropertySpec consumidos por duas suítes (arquitetura §10): um vitest que roda o PropertySpec de TypeScript e src-tauri/tests/db_value_invariants.rs, que roda o espelho Rust de normalização/vazio (src-tauri/src/db/record_values.rs) e confere sort_text/sort_num calculados PELO POSTGRES sobre o mesmo `value` inserido de verdade. `expectedPlainText` é conferido só pelo lado TS — nenhum toPlainText existe no Rust desta peça (N2); ver `divergencias_da_arquitetura` no relatório de N2.",
  "cases": [
    {
      "id": "text_valid_short",
      "propertyType": "text",
      "config": {},
      "value": "Anotação da Fase 3",
      "expectedPlainText": "Anotação da Fase 3",
      "expectedSortText": "Anotação da Fase 3",
      "expectedSortNum": null,
      "expectedIsEmpty": false
    },
    {
      "id": "text_empty_string_is_no_row",
      "propertyType": "text",
      "config": {},
      "value": "",
      "expectedPlainText": "",
      "expectedSortText": null,
      "expectedSortNum": null,
      "expectedIsEmpty": true
    },
    {
      "id": "text_high_entropy_6400_chars_truncates_sort_text_at_256",
      "propertyType": "text",
      "config": {},
      "value": "",
      "expectedPlainText": "",
      "expectedSortText": "285b40de70c6257eb65c574031a350ed91e6413db25182c803b237ddc905ec8dba5d7780bd022c993c331fb794efede46303bac1da2ab4f8be3a08a76434daee09dcb5877ac5e3c52d67fe0ca14d0d4025bfb1eca5eb9346a2c8afdbfbe341aef647807ad4e25413b02c6305fc0775fa11a846b63e05ecfd12609574ee461323",
      "expectedSortNum": null,
      "expectedIsEmpty": false
    },
    {
      "id": "number_valid_fraction",
      "propertyType": "number",
      "config": {
        "format": "plain"
      },
      "value": 42.5,
      "expectedPlainText": "42.5",
      "expectedSortText": null,
      "expectedSortNum": 42.5,
      "expectedIsEmpty": false
    },
    {
      "id": "number_zero_is_not_empty",
      "propertyType": "number",
      "config": {
        "format": "plain"
      },
      "value": 0,
      "expectedPlainText": "0",
      "expectedSortText": null,
      "expectedSortNum": 0,
      "expectedIsEmpty": false
    },
    {
      "id": "checkbox_true",
      "propertyType": "checkbox",
      "config": {},
      "value": true,
      "expectedPlainText": "Sim",
      "expectedSortText": null,
      "expectedSortNum": 1,
      "expectedIsEmpty": false
    },
    {
      "id": "checkbox_false_is_zero_rows",
      "propertyType": "checkbox",
      "config": {},
      "value": false,
      "expectedPlainText": "",
      "expectedSortText": null,
      "expectedSortNum": null,
      "expectedIsEmpty": true
    },
    {
      "id": "formula_boolean_false_is_a_legitimate_value",
      "propertyType": "formula",
      "config": {
        "expression": "prop(\"Aprovado\") == false"
      },
      "value": false,
      "expectedPlainText": "Não",
      "expectedSortText": null,
      "expectedSortNum": 0,
      "expectedIsEmpty": false
    },
    {
      "id": "option_valid",
      "propertyType": "select",
      "config": {
        "options": [
          {
            "id": "opt_a",
            "label": "A Fazer",
            "color": "gray"
          }
        ]
      },
      "value": "opt_a",
      "expectedPlainText": "A Fazer",
      "expectedSortText": "opt_a",
      "expectedSortNum": null,
      "expectedIsEmpty": false
    },
    {
      "id": "option_empty_string_is_no_row",
      "propertyType": "select",
      "config": {
        "options": [
          {
            "id": "opt_a",
            "label": "A Fazer",
            "color": "gray"
          }
        ]
      },
      "value": "",
      "expectedPlainText": "",
      "expectedSortText": null,
      "expectedSortNum": null,
      "expectedIsEmpty": true
    },
    {
      "id": "option_list_valid",
      "propertyType": "multi_select",
      "config": {
        "options": [
          {
            "id": "opt_a",
            "label": "A Fazer",
            "color": "gray"
          },
          {
            "id": "opt_b",
            "label": "Em Progresso",
            "color": "blue"
          }
        ]
      },
      "value": [
