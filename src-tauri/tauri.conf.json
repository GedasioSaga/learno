{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "learno",
  "version": "0.2.0",
  "identifier": "com.learno.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Learno",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' blob:",
        "img-src": "'self' data: blob: http://asset.localhost",
        "media-src": "'self' blob: http://asset.localhost",
        "font-src": "'self' blob:",
        "connect-src": "'self' blob: ipc: http://ipc.localhost http://asset.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/media/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyRTM0Nzk2NjQ2RkNGMjYKUldRbXoyOWtsa2Zqa3FDNDMwa3Y3Vnd5cWpFWjJDNTA1T2tHd0lNUUo1NEhRZG1wSEgxT2lhcHUK",
      "endpoints": [
        "https://github.com/GedasioSaga/learno/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/learno-sidecar"]
  }
}
