        "hasEnd": false
      },
      "value": {
        "start": "2026-02-01"
      },
      "expectedPlainText": "2026-02-01",
      "expectedSortText": "2026-02-01",
      "expectedSortNum": null,
      "expectedIsEmpty": false
    },
    {
      "id": "date_range_earlier_but_two_keys",
      "propertyType": "date",
      "config": {
        "includeTime": false,
        "hasEnd": true
      },
      "value": {
        "start": "2026-01-01",
        "end": "2026-01-02"
      },
      "expectedPlainText": "2026-01-01 – 2026-01-02",
      "expectedSortText": "2026-01-01",
      "expectedSortNum": null,
      "expectedIsEmpty": false
    },
    {
      "id": "person_valid_with_email",
      "propertyType": "person",
      "config": {},
      "value": {
        "name": "Ana Silva",
