      },
      "expectedPlainText": "Ana Silva <ana@example.com>",
      "expectedSortText": null,
      "expectedSortNum": null,
      "expectedIsEmpty": false
    },
    {
      "id": "person_edge_without_email",
      "propertyType": "person",
      "config": {},
      "value": {
        "name": "Carlos",
        "email": null
      },
      "expectedPlainText": "Carlos",
      "expectedSortText": null,
      "expectedSortNum": null,
      "expectedIsEmpty": false
